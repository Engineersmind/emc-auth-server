# EMC Auth Server — Environment Variables
# Copy to .env and fill in values

# ── Server ─────────────────────────────────────────────────────
PORT=8080
ENV=development                  # development | staging | production

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgres://emc_auth:password@localhost:5432/emc_auth?sslmode=disable

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-in-production
JWT_ACCESS_TTL=3600              # seconds (1 hour)
JWT_REFRESH_TTL=2592000          # seconds (30 days)
JWT_ISSUER=https://auth.engineersmind.com
JWT_AUDIENCE=https://api.engineersmind.com

# ── Admin UI ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@engineersmind.com
ADMIN_PASSWORD=change-me

# ── Email (for password reset, OTP) ───────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@engineersmind.com

# ── SAML (optional) ────────────────────────────────────────────
SAML_ENTITY_ID=https://auth.engineersmind.com
SAML_CERT_FILE=./certs/saml.crt
SAML_KEY_FILE=./certs/saml.key

# ── API Keys ───────────────────────────────────────────────────
API_KEY_HEADER=x-api-key
