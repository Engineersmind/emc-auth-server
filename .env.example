# EMC Auth Server — Environment Variables
# Copy to .env and fill in values

# ── Server ─────────────────────────────────────────────────────
PORT=9090
ENV=development                  # development | staging | production

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgres://emc_auth:password@localhost:5432/emc_auth?sslmode=disable

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-in-production
JWT_ACCESS_TTL=3600              # seconds (1 hour)
JWT_REFRESH_TTL=2592000          # seconds (30 days)
JWT_ISSUER=https://auth.engineersmind.com
JWT_AUDIENCE=https://api.engineersmind.com

# ── Admin UI ───────────────────────────────────────────────────
# Phase 1 seeds a default super-admin user for the emc tenant.
# Use SEED_ADMIN_PASSWORD to override the default password.
SEED_ADMIN_PASSWORD=ChangeMe123!

# Default Phase 1 admin credentials:
#   Email: admin@emc.local
#   Password: ChangeMe123!

# ── Email (verification, password reset, OTP, magic link, welcome) ────────────
# GLOBAL provider: "sendgrid" (Web API, recommended) or "smtp". Empty = inferred
# (sendgrid if SENDGRID_API_KEY set, else smtp if SMTP_HOST set, else log-only).
# Per-tenant/app senders (admin API) override this: application → tenant → global.
EMAIL_PROVIDER=sendgrid

# SendGrid Web API (provider=sendgrid). Use a Restricted "Mail Send" API key.
# SMTP_FROM must be a verified sender / authenticated domain (DKIM/SPF).
SENDGRID_API_KEY=your-sendgrid-api-key
SMTP_FROM=noreply@engineersmind.com
EMAIL_FROM_NAME=EMC Auth

# SMTP relay (provider=smtp). NOTE: the code reads SMTP_USERNAME / SMTP_FROM
# (not SMTP_USER / EMAIL_FROM). For SendGrid over SMTP: host smtp.sendgrid.net,
# SMTP_USERNAME=apikey, SMTP_PASSWORD=<api key>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# TLS: blank = auto (587→STARTTLS, 465→implicit TLS). Override: ssl|starttls|opportunistic|none
SMTP_TLS=

# ── SAML (optional) ────────────────────────────────────────────
SAML_ENTITY_ID=https://auth.engineersmind.com
SAML_CERT_FILE=./certs/saml.crt
SAML_KEY_FILE=./certs/saml.key

# ── TOTP 2FA ────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of TOTP secrets at rest.
# Generate with: openssl rand -hex 32
# REQUIRED when TOTP is enabled. In development a zero key is used (logged as warning).
TOTP_ENCRYPTION_KEY=

# ── Social login (issue #64) ─────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of identity provider client
# secrets at rest (Google OAuth etc.). Generate with: openssl rand -hex 32
# REQUIRED in production/staging — the server refuses to start without it.
# In development a zero key is used (logged as warning).
OAUTH_CLIENT_SECRET_ENCRYPTION_KEY=
# Key rotation: move the old key here, put the new key above. Decryption
# falls back to this key; rows re-encrypt on their next admin write.
# Leave empty when no rotation is in progress.
# OAUTH_CLIENT_SECRET_ENCRYPTION_KEY_PREVIOUS=

# ── JWT signing keys (asymmetric RS256, issue #95) ──────────────
# 32-byte hex key for AES-256-GCM encryption of the RSA PRIVATE keys used to
# sign JWTs (signing_keys.private_key_enc). Generate with: openssl rand -hex 32
# REQUIRED in production/staging — the server refuses to start without it.
# In development a zero key is used (logged as warning).
#
# This protects token-SIGNING authority: anyone who can decrypt these rows can
# mint a token for any user in the affected tenant. Keep it separate from the
# OAuth key above so a social-login secret leak does not also grant that.
JWT_SIGNING_KEY_ENCRYPTION_KEY=
# Rotation of the ENCRYPTION key above (not of the signing keys themselves —
# that is POST /api/v1/signing-keys/prepare then /complete). Move the old
# key here, put the new key above; decryption falls back transparently.
# JWT_SIGNING_KEY_ENCRYPTION_KEY_PREVIOUS=
#
# Phase 4 cutover switch. While true (the default), tokens signed with the legacy
# symmetric tenants.jwt_secret still verify, so upgrading to RS256 does not
# invalidate tokens minted seconds earlier. Set to false to REJECT HS256 outright —
# that is the step that actually removes the forging risk, and it is one-way in
# effect. Do not flip it until emc_auth_legacy_hs256_verifications_total has been
# flat at zero for ~2h. Full runbook: docs/PHASE4_HS256_CUTOVER.md
# JWT_ALLOW_LEGACY_HS256=true
#
# NOTE: tenant public keys are published, unauthenticated, at
#   {APP_BASE_URL}/tenants/{tenant-slug}/.well-known/jwks.json
# APP_BASE_URL is authoritative for that URL. If JWT_ISSUER points at a
# different host, the server logs a warning at startup (an error in production)
# because verifiers following OIDC discovery derive the JWKS URL from "iss".

# ── OpenTelemetry (devops-copilot) ──────────────────────────────
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable APM + error tracking.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5000   # devops-copilot on same host
# OTEL_SERVICE_NAME=emc-auth-server
# Sentry-compatible ingest (devops-copilot with ENABLE_SENTRY_COMPAT=1):
# SENTRY_DSN=http://ingest@localhost:5000/1
# ── Cookies ──────────────────────────────────────────────────────
# COOKIE_DOMAIN: shared parent domain for auth cookies.
#   development  → leave empty (browser scopes to localhost automatically)
#   staging/prod → set to ".yourdomain.com" so both the API host and the
#                  frontend host (on subdomains) share the same cookie.
#
# Cookie behaviour is derived from ENV:
#   development          → SameSite=Lax,  Secure=false  (HTTP localhost)
#   staging / production → SameSite=None, Secure=true   (HTTPS cross-domain)
#
# SameSite=None is required when the frontend and API are on different domains.
# Browsers reject SameSite=None without Secure=true, so HTTPS is mandatory in prod.
COOKIE_DOMAIN=

# ── API Keys ─────────────────────────────────────────────────────
# API keys use the "emck_" prefix and SHA-256 hash storage.
# No additional configuration needed — managed via /admin/api-keys endpoints.

# ── Global CORS (slug-less endpoints) ─────────────────────────────
# Allowed browser origins for endpoints that resolve their tenant internally
# (e.g. /auth/login), so there's no X-Tenant-Slug to look up a per-tenant
# origin list by. Comma-separated, no trailing slashes.
GLOBAL_CORS_ORIGINS=

# ── Breached-password warnings ────────────────────────────────────
# When true, each accepted password is checked against the Have I Been Pwned
# corpus and the user is emailed the password_breach template on a hit. The
# check is k-anonymous: only the first 5 characters of the password's SHA-1
# hash leave the server (api.pwnedpasswords.com/range/<prefix>), and the match
# is made locally — the password and its full hash are never transmitted.
#
# It is advisory: a hit warns the user, it never blocks the login. Off by
# default because it makes an outbound call to a third party.
BREACH_DETECTION_ENABLED=false
