  {
   "name": "08 — owner lists the app's permission catalog",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{owner_token}}"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/tenants/{{tid}}/applications/{{app_id}}/permissions",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "tenants",
      "{{tid}}",
      "applications",
      "{{app_id}}",
      "permissions"
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('list 200', () => pm.response.to.have.status(200));",
       "const perms = pm.response.json();",
       "pm.test('exactly the 2 app permissions', () => perms.length === 2);",
       "pm.test('all scoped to this app', () => perms.every(p => p.application_id === pm.collectionVariables.get('app_id')));"
      ]
     }
    }
   ]
  },
