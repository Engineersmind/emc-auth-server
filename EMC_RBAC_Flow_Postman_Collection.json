       "pm.test('scoped to the application', () => j.application_id === pm.collectionVariables.get('app_id'));",
       "pm.test('not default until marked', () => j.is_default === false);",
       "pm.collectionVariables.set('role_viewer_id', j.id);"
      ]
     }
    }
   ]
  },
