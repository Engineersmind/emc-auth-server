    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('application created 201', () => pm.response.to.have.status(201));",
       "const j = pm.response.json();",
       "pm.collectionVariables.set('app_id', j.id);",
       "pm.collectionVariables.set('client_id', j.client_id);",
       "pm.collectionVariables.set('client_secret', j.client_secret);",
       "pm.test('client credentials returned once', () => !!j.client_id && !!j.client_secret);"
      ]
     }
    }
   ]
  },
