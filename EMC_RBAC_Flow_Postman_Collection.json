  {
   "name": "16 — end user registers via app credentials → default role on JWT",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/auth/apps/register",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "auth",
      "apps",
      "register"
     ]
    },
    "auth": {
     "type": "basic",
     "basic": [
      {
       "key": "username",
       "value": "{{client_id}}",
       "type": "string"
      },
      {
       "key": "password",
       "value": "{{client_secret}}",
       "type": "string"
      }
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"email\": \"{{end_user_email}}\",\n  \"password\": \"EndUserPass123!\",\n  \"first_name\": \"End\",\n  \"last_name\": \"User\"\n}"
    }
   },
   "event": [
