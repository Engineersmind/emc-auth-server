      "applications",
      "{{app_id}}",
      "roles"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"viewer\",\n  \"permission_ids\": [\"{{perm_read_id}}\"]\n}"
    }
   },
   "event": [
