   "request": {
    "method": "PUT",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{owner_token}}"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/tenants/{{tid}}/applications/{{app_id}}/roles/{{role_viewer_id}}/default",
