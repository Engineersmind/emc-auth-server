{
 "info": {
  "name": "EMC Auth — Application RBAC Flow",
  "description": "End-to-end flow for application-scoped RBAC on the canonical /tenants/{tid}/... API family.\n\nFlow: super_admin creates a tenant (owner auto-seeded) → owner creates an application → owner defines the app's isolated permission catalog → owner creates roles inside the app and attaches permissions → owner marks one role default → end users register/login through the app's client credentials and receive JWTs carrying role + permissions.\n\nSet admin_password before running. Fully re-runnable: tenant slug, emails, and names are timestamped per run. Requests are sequential — run top to bottom (Collection Runner or newman).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "01 — super_admin login",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/auth/login",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "auth",
      "login"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('login 200', () => pm.response.to.have.status(200));",
       "const j = pm.response.json();",
       "pm.collectionVariables.set('admin_token', j.access_token);"
      ]
     }
    }
   ]
  },
  {
   "name": "02 — super_admin creates tenant (owner auto-seeded)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer {{admin_token}}"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/tenants",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "tenants"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"RBAC Demo {{tenant_suffix}}\",\n  \"slug\": \"rbac-demo-{{tenant_suffix}}\",\n  \"owner_email\": \"owner-{{tenant_suffix}}@rbac.test\"\n}"
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.collectionVariables.set('tenant_suffix', String(Date.now()));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('tenant created 201', () => pm.response.to.have.status(201));",
       "const j = pm.response.json();",
       "pm.collectionVariables.set('tid', j.tenant.id);",
       "pm.collectionVariables.set('owner_email', j.owner.email);",
       "pm.collectionVariables.set('owner_password', j.owner.temp_password);",
       "pm.test('owner temp password returned once', () => !!j.owner.temp_password);"
      ]
     }
    }
   ]
  },
  {
   "name": "03 — owner login (temp password)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/auth/login",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "auth",
      "login"
     ]
    },
    "body": {
     "mode": "raw",
     "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}"
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('owner login 200', () => pm.response.to.have.status(200));",
       "const j = pm.response.json();",
       "pm.collectionVariables.set('owner_token', j.access_token);",
       "const payload = JSON.parse(atob(j.access_token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
       "pm.test('role claim = owner', () => payload.role === 'owner');",
       "pm.test('tid matches created tenant', () => payload.tenant_id === pm.collectionVariables.get('tid'));"
      ]
     }
    }
   ]
  },
