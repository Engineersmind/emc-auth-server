  {
   "name": "18 — end user fetches own profile (/auth/me)",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{end_user_token}}"
     }
    ],
    "url": {
     "raw": "{{base_url}}/api/v1/auth/me",
     "host": [
      "{{base_url}}"
     ],
     "path": [
      "api",
      "v1",
      "auth",
      "me"
     ]
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('me 200', () => pm.response.to.have.status(200));",
       "const j = pm.response.json();",
       "pm.test('role = viewer', () => j.role === 'viewer');"
