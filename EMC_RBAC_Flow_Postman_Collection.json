    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('register 201', () => pm.response.to.have.status(201));",
       "const j = pm.response.json();",
       "pm.collectionVariables.set('end_user_token', j.access_token);",
       "const payload = JSON.parse(atob(j.access_token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
       "pm.test('default role auto-assigned', () => payload.role === 'viewer');",
       "pm.test('permissions from the role', () => JSON.stringify(payload.permissions) === JSON.stringify([pm.collectionVariables.get('perm_read_name')]));",
       "pm.test('app stamped on token', () => payload.app_id === pm.collectionVariables.get('app_id'));"
      ]
     }
    }
   ]
